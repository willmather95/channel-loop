# channel-loop needs NO credentials: it runs on a SIMULATED account.
# A live deployment would pass these to the sibling repos' adapters. Placeholders only.
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_ACCESS_TOKEN=oauth-access-token-refreshed-outside-this-repo
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
META_ACCESS_TOKEN=system-user-token-with-ads_management
META_AD_ACCOUNT_ID=act_0000000000
POSTHOG_PROJECT_API_KEY=placeholder-project-key
# Kill switch: any value other than 0/false/empty stops every write the loop makes
CHANNEL_LOOP_KILL=0
